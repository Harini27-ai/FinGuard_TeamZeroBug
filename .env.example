# ==========================================
# Database Configuration
# Local SQLite fallback: sqlite:///./finguard.db
# PostgreSQL: postgresql+psycopg://finguard:finguard@localhost:5432/finguard
# ==========================================
DATABASE_URL=sqlite:///./finguard.db

# ==========================================
# Security & JWT Authentication
# ==========================================
JWT_SECRET=finguard-super-secure-production-secret-key-2026-financial-immune-system
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# ==========================================
# Optional Graph & Cache Connectors
# ==========================================
NEO4J_URI=
NEO4J_USER=neo4j
NEO4J_PASSWORD=
REDIS_URL=

# ==========================================
# CORS Configuration
# ==========================================
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# ==========================================
# Optional External AI Engine API Keys
# ==========================================
AI_API_KEY=
